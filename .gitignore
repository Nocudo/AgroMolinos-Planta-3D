# ==========================================
# Web / Node / Three.js Ignore Rules
# ==========================================
node_modules/
dist/
build/
.cache/
.vite/
*.local

# Visual Studio Code / IDE
.vscode/
.idea/

# OS Generated
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# MATLAB / Simulink Ignore Rules
# ==========================================
*.asv
*.slxc
slprj/
*.autosave
*~

# ==========================================
# LaTeX Compilation Auxiliary Files
# ==========================================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# ==========================================
# Python Ignore Rules
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Temporary & Scratch Files
# ==========================================
*.tmp
temp/
scratch/
