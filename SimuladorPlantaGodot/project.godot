; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is also a plain text file.

config_version=5

[application]

config/name="AgroMolinos 3D Serious Game"
config/description="Simulador y Serious Game para Planta Molino de Granos 10 HP - Universidad de los Llanos (2026-2)"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/EventBus.gd"
SimulationManager="*res://scripts/core/SimulationManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode="fullscreen"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

